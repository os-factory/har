# Agent environment — generated by launch.sh from env.template
# DO NOT EDIT — regenerated on every launch
AGENT_ID=${AGENT_ID}

# Ports (allocated at launch — may differ from BASE + AGENT_ID × STEP when busy)
# Astro serves the whole site (landing + docs) on one port.
PORT=${FE_PORT}
FE_PORT=${FE_PORT}
API_PORT=${FE_PORT}
DEBUG_PORT=${DEBUG_PORT}

# Application
NODE_ENV=development
SITE_URL=http://localhost:${FE_PORT}

# Playwright / browser-e2e (injected again by stages/browser-e2e.sh)
BASE_URL=http://localhost:${FE_PORT}
API_URL=http://localhost:${FE_PORT}

# Toolchain paths — appended by provision-toolchain.sh during launch
# NODE_BIN=  NPM_BIN=
