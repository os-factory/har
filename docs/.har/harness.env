# Shared harness configuration — Astro docs / marketing site
# Maintained with: cd docs && har env maintain

export HARNESS_PROJECT_NAME=docs
export HARNESS_USE_WORKTREE=true

# Primary application — the Astro site (landing + Starlight docs). Single process.
export HARNESS_PRIMARY_APP=web

# No database — static/marketing site with optional client-side analytics only.
export HARNESS_TEMPLATE_DB=""

# ── Per-slot app ports (PM2 / primary app) ────────────────────────────────────
# Astro serves UI on one port. Defaults: BASE + (AGENT_ID × STEP).
# Slot 1 → 4321 (Astro’s conventional local port). Avoids Mission Control (3847+).
export HARNESS_FE_BASE_PORT=4311
export HARNESS_API_BASE_PORT=4311
export HARNESS_PORT_STEP=10
# Site root is the liveness probe (no dedicated /health route).
export HARNESS_HEALTH_CHECK_PATH=/

# Agent slot limits — canonical source: .har/stages.json (agentSlots).
# Legacy fallback; har env maintain --finalize syncs these from stages.json.
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=5

# Toolchain provisioning — launch writes resolved paths into .env.agent.<id>
export HARNESS_ECOSYSTEM="node"
# export HARNESS_INSTALL_CMD="npm ci"

# No shared Docker infra for the docs site.
export HARNESS_INFRA_SERVICES=""

# Returns 0 when a shared infra service is enabled: har_infra_enabled db
har_infra_enabled() {
  case " ${HARNESS_INFRA_SERVICES:-} " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# No migrate/seed — schema-only / DB bootstrap does not apply.
export HARNESS_DB_MIGRATE_CMD=""
export HARNESS_DB_SEED_CMD=""

# Agent-usable smoke beyond HTTP 200 on / — landing hero must render.
# Full verify also runs Playwright visual-proof screenshots.
export HARNESS_READINESS_CMD='curl -sf "http://localhost:${FE_PORT:-${API_PORT}}/" | grep -q "The open harness for multi-agent coding workflows"'
