{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "verificationStages": [
    "typecheck",
    "site-health",
    "unit-tests",
    "lint",
    "drift",
    "build",
    "links",
    "readiness",
    "browser-e2e"
  ],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Shared infrastructure (no-op for docs \u2014 no Docker services)",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch an isolated Astro docs slot (worktree + PM2 + before screenshots)",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        },
        {
          "path": ".har/artifacts/browser-e2e/screenshots/before",
          "kind": "directory",
          "description": "Baseline full-page screenshots captured at launch"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick: check + health; --full: drift, build, links, browser-e2e with after screenshots)",
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Verification outputs: reports, traces, before/after screenshots"
        }
      ],
      "acceptsArgs": [
        "--full"
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect a running agent environment slot",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "artifacts": []
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Stop processes and release agent slot resources",
      "artifacts": []
    },
    {
      "id": "browser-e2e",
      "kind": "test",
      "description": "Playwright E2E (frontend + API + a11y) and after screenshots",
      "script": "stages/browser-e2e.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/browser-e2e",
          "kind": "directory",
          "description": "HTML report, traces, after screenshots"
        },
        {
          "path": ".har/artifacts/browser-e2e/screenshots/after",
          "kind": "directory",
          "description": "Full-page after screenshots for session handoff"
        },
        {
          "path": ".har/artifacts/browser-e2e/playwright-report",
          "kind": "report"
        }
      ],
      "requiresAgentId": true
    },
    {
      "id": "capture-screenshots",
      "kind": "test",
      "description": "Capture before/after full-page screenshots (visual proof)",
      "script": "stages/capture-screenshots.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/browser-e2e/screenshots",
          "kind": "directory",
          "description": "before/ and after/ PNG directories"
        }
      ],
      "requiresAgentId": true
    },
    {
      "id": "typecheck",
      "kind": "test",
      "description": "Astro/content typecheck (astro check; pre-1.0 stage id: check)",
      "command": "${NPM_BIN:-npm} run check",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "quick"
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "description": "Unit tests",
      "command": "echo 'No test script configured; skipping.'",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "lint",
      "kind": "test",
      "description": "Lint",
      "command": "echo 'No lint script configured; skipping.'",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "readiness",
      "kind": "test",
      "description": "Project readiness smoke (HARNESS_READINESS_CMD)",
      "script": "stages/readiness.sh",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "site-health",
      "kind": "test",
      "tier": "quick",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "curl -sf \"http://localhost:${FE_PORT:-${API_PORT}}${HARNESS_HEALTH_CHECK_PATH:-/}\" >/dev/null",
      "description": "Site health check on the slot dev server"
    },
    {
      "id": "drift",
      "kind": "test",
      "tier": "full",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "${NPM_BIN:-npm} run drift",
      "description": "Docs drift vs CLI/MCP/stage/profile/template/skill contracts"
    },
    {
      "id": "build",
      "kind": "test",
      "tier": "full",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "${NPM_BIN:-npm} run build",
      "description": "Astro production build"
    },
    {
      "id": "links",
      "kind": "test",
      "tier": "full",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "if command -v lychee >/dev/null 2>&1; then ${NPM_BIN:-npm} run links; else echo \"lychee not on PATH; skipping links (CI installs it via docs.yml).\"; fi",
      "description": "Link check (lychee)"
    }
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  }
}
