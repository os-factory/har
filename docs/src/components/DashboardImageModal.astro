<div class="dashboard-image-modal" data-dashboard-image-modal hidden>
  <button
    type="button"
    class="dashboard-image-modal-backdrop"
    data-dashboard-image-close
    aria-label="Close image"
  ></button>
  <div
    class="dashboard-image-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Dashboard screenshot"
  >
    <button type="button" class="dashboard-image-modal-close" data-dashboard-image-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    <div class="dashboard-image-modal-viewport" data-dashboard-image-viewport>
      <img data-dashboard-image-target alt="" draggable="false" decoding="async" />
    </div>
    <p class="dashboard-image-modal-hint">Pinch or double-tap to zoom · drag to pan</p>
  </div>
</div>
