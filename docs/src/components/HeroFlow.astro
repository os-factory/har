---
import HeroVerificationFlow from './HeroVerificationFlow';
---

<div class="flow-window">
  <div class="window-topbar">
    <div class="window-lights"><span></span><span></span><span></span></div>
    <span class="window-label">agent-session / slot-03</span>
    <span class="window-status"><i></i> running</span>
  </div>

  <div class="hero-flow-canvas">
    <HeroVerificationFlow client:only="react" />
  </div>

  <div class="flow-footer">
    <span><i></i> deterministic verification</span>
    <code>har env verify 3 --full</code>
  </div>
</div>
