---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroFlow from '../components/HeroFlow.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import { formatHeroRunTotal } from '../lib/hero-stage-meta';
import { plugins } from '../data/plugins';

const heroRunTotal = formatHeroRunTotal();

// Customer logos — the first row shows a rotating window over the full set.
const customers = [
  { src: '/assets/logo-notion.svg', alt: 'Notion' },
  { src: '/assets/logo-figma.svg', alt: 'Figma' },
  { src: '/assets/logo-stripe.svg', alt: 'Stripe' },
  { src: '/assets/logo-sentry.svg', alt: 'Sentry' },
  { src: '/assets/logo-datadog.svg', alt: 'Datadog' },
  { src: '/assets/logo-aws.svg', alt: 'Amazon Web Services' },
  { src: '/assets/logo-adobe.svg', alt: 'Adobe' },
  { src: '/assets/logo-salesforce.svg', alt: 'Salesforce' },
  { src: '/assets/logo-uber.svg', alt: 'Uber' },
  { src: '/assets/logo-spotify.svg', alt: 'Spotify' },
  { src: '/assets/logo-accenture.svg', alt: 'Accenture' },
];
---
<BaseLayout
  title="HAR — Open agent harness (CLI + MCP) for coding agents"
  description="HAR is an open-source agent harness — CLI and MCP server — for multi-agent coding workflows. Isolated worktrees, deterministic verification, and software-factory observability for Claude Code, Cursor, and Codex."
  bodyClass="home-page has-release-banner"
  canonicalPath="/"
>
  <AnnouncementBanner href="/blog/har-1-0-0/" />
  <Header active="home" />
  <main>
<section class="hero blueprint-surface">
<div class="container hero-grid">
<div class="hero-copy reveal">
<div class="eyebrow"><span class="eyebrow-dot"></span> Open harness · Agent-agnostic</div>
<h1>Build AI coding workflows you can trust and verify.</h1>
<p class="hero-lede">HAR runs every coding agent in an isolated, consistent environment, with deterministic validation, verifiable proof, and full observability. Extensible to your own workflow.</p>
<div class="hero-install">
<button aria-label="Copy install command" class="install-command" data-copy="npm install -g @osfactory/har@latest" type="button">
<span class="terminal-prompt">$</span>
<code>npm install -g @osfactory/har@latest</code>
<span class="copy-label" data-copy-label="">Copy</span>
</button>
<a class="hero-docs-link" href="/docs">Read the docs <span aria-hidden="true">→</span></a>
</div>
<div class="compatibility">
<div class="compat-row">
<span class="compat-label">Works with</span>
<div class="agent-logos" role="list" aria-label="Compatible coding agents" data-rotate>
<span class="agent-logo" role="listitem"><svg height="1em" viewBox="0 0 24 24" width="1em" xmlns="http://www.w3.org/2000/svg"><title>Claude Code</title><path clip-rule="evenodd" d="M20.998 10.949H24v3.102h-3v3.028h-1.487V20H18v-2.921h-1.487V20H15v-2.921H9V20H7.488v-2.921H6V20H4.487v-2.921H3V14.05H0V10.95h3V5h17.998v5.949zM6 10.949h1.488V8.102H6v2.847zm10.51 0H18V8.102h-1.49v2.847z" fill="#D97757" fill-rule="evenodd"></path></svg></span>
