{
  "name": "@osfactory/har",
  "version": "0.50.1",
  "description": "Open harness for reproducible multi-agent coding workflows",
  "keywords": [
    "har",
    "cli",
    "mcp",
    "agent",
    "harness",
    "devops"
  ],
  "bin": {
    "har": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/ensure-telemetry-default.cjs",
    "control/docker-compose.yml",
    "control/docker-compose.build.yml"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --banner:js='#!/usr/bin/env node' && rm -rf dist/templates && cp -r src/templates dist/templates",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "postinstall": "node scripts/ensure-telemetry-default.cjs",
    "prepublishOnly": "npm run build",
    "release": "semantic-release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pydantic/genai-prices": "^0.0.73",
    "chalk": "^5.3.0",
    "inquirer": "^10.1.2",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.1",
    "yargs": "^17.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "semantic-release": "^24.2.3",
    "ts-jest": "^29.2.4",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/os-factory/har"
  },
  "homepage": "https://harproject.dev/",
  "bugs": "https://github.com/os-factory/har/issues",
  "author": "Antoine Frau",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
