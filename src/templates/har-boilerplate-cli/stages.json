{
  "version": "1",
  "agentSlots": {
    "min": 1,
    "max": 3
  },
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  },
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure"
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Prepare agent slot (git worktree, deps, env file)",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline: runs stages.json verificationStages in order (tier \"quick\" by default; --full runs the whole list)",
      "acceptsArgs": [
        "--full"
      ],
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs"
        }
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect agent slot status and worktree path",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Remove worktree and env file for the slot"
    },
    {
      "id": "typecheck",
      "kind": "test",
      "tier": "quick",
      "description": "Ecosystem quick smoke (registered from HARNESS_ECOSYSTEM at init; adapt to this repo)",
      "command": "${NPM_BIN:-npm} run typecheck",
      "requiresAgentId": true
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "tier": "full",
      "description": "Unit tests",
      "command": "${NPM_BIN:-npm} test",
      "requiresAgentId": true
    },
    {
      "id": "lint",
      "kind": "test",
      "tier": "full",
      "description": "Lint",
      "command": "${NPM_BIN:-npm} run lint",
      "requiresAgentId": true
    },
    {
      "id": "readiness",
      "kind": "test",
      "tier": "full",
      "description": "Project readiness smoke (HARNESS_READINESS_CMD)",
      "script": "stages/readiness.sh",
      "requiresAgentId": true
    }
  ],
  "verificationStages": [
    "typecheck",
    "unit-tests",
    "lint",
    "readiness"
  ]
}
