# iOS mobile app harness — Xcode / iOS Simulator, no PM2, no Docker infra
# Generated when the harness is scaffolded (--profile ios)
#
# This file is pure KEY=value config (plus comments) and is schema-validated
# on read. Runtime helpers (har_infra_enabled, port resolution) live in
# .har/lib/ — never define functions here.

export HARNESS_PROJECT_NAME=__PROJECT_NAME__
export HARNESS_USE_WORKTREE=true

export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# Toolchain provisioning — launch writes Xcode/simulator paths into .env.agent.<id>
export HARNESS_ECOSYSTEM="ios"
# Generated projects: when the worktree has no .xcodeproj/.xcworkspace, launch runs
# the generator this repo declares — tuist generate (Project.swift), xcodegen
# generate (project.yml) — plus pod install when a Podfile is present and Pods/ is
# missing. A missing generator fails the launch by name.
# HARNESS_INSTALL_CMD owns provisioning outright: set it and no default generator
# runs, and its failure fails the launch.
# export HARNESS_INSTALL_CMD="xcodebuild -resolvePackageDependencies ..."
# Node package manager: auto-detected from package.json "packageManager" and the
# lockfile (bun.lock → bun, pnpm-lock.yaml → pnpm, yarn.lock → yarn, else npm),
# falling back to whichever is installed. Set to pin one: npm | bun | pnpm | yarn
# export HARNESS_NODE_PACKAGE_MANAGER="bun"

# ── Xcode project ─────────────────────────────────────────────────────────────
# Set one of HARNESS_XCODE_WORKSPACE or HARNESS_XCODE_PROJECT (workspace wins).
export HARNESS_XCODE_WORKSPACE=""     # e.g. MyApp.xcworkspace (relative to repo root)
export HARNESS_XCODE_PROJECT=""       # e.g. MyApp.xcodeproj (relative to repo root)

# Xcode scheme to build and test (must be marked as shared in Xcode).
export HARNESS_XCODE_SCHEME="MyApp"

# Simulator model each slot runs on, e.g. "iPhone 16", "iPhone 16 Pro", "iPad Air 11-inch (M2)".
# Use: xcrun simctl list devicetypes. Leave empty for the newest model of the family.
export HARNESS_SIMULATOR_NAME="iPhone 16"

# Bundle ID of the app under test. Used by agent-cli.sh / RocketSim flows.
export HARNESS_BUNDLE_ID="com.example.myapp"

# ── Simulator allocation ──────────────────────────────────────────────────────
# Every slot gets its own simulator, "har-<project>-agent-<id>-<model>", created
# at launch from HARNESS_SIMULATOR_NAME and deleted at teardown. Concurrent agents
# therefore never share a destination, an installed bundle id, or a UI session,
# each launch starts from a pristine device, and the simulators you use by hand
# are never touched. launch.sh writes the device into .env.agent.<id>.
#
# The runtime is the newest installed iOS that supports the model; launch fails
# with the list of available models when none does.

# Family used when HARNESS_SIMULATOR_NAME is empty, and enforced when it is set:
# auto (infer from the name) | iPhone | iPad. An iPad is only ever created when
# this resolves to iPad.
export HARNESS_SIMULATOR_FAMILY="auto"

# Run every slot on one existing device instead of creating any (bypasses model
# resolution — no fallback). Slots then share it, so use it for one-off debugging.
# export HARNESS_SIMULATOR_UDID=""

# Set true to go back to one shared simulator for all slots, resolved by exact
# name from HARNESS_SIMULATOR_NAME and booted by setup-infra.sh.
export HARNESS_SIMULATOR_SHARED=false

# Destination used when slots share a simulator; per-slot launches override it
# with the reserved device's UDID. Empty = derived from HARNESS_SIMULATOR_NAME.
export HARNESS_IOS_DESTINATION=""

# Optional SwiftLint path (empty = system-installed swiftlint).
# export HARNESS_SWIFTLINT_CMD="swiftlint"

# ── Infrastructure ────────────────────────────────────────────────────────────
# No Docker infra for pure iOS apps. Set service names here (space-separated)
# only if your app needs a local backend container (e.g. a mock server).
# When enabled, declare a matching port lane for each service:
# export HARNESS_INFRA_PORT_LANES="mock-server=18080:18080-18099"
export HARNESS_INFRA_SERVICES=""

# Optional "agent usable" smoke beyond build/test, such as a simulator flow or
# backend-auth check. Enable only when this project needs it.
# export HARNESS_READINESS_CMD="./.har/readiness.sh"
