{
  "id": "cypress",
  "stageId": "cypress-e2e",
  "verificationStages": [
    "cypress-e2e"
  ],
  "stage": {
    "id": "cypress-e2e",
    "kind": "test",
    "description": "Cypress end-to-end tests against the slot's running app",
    "script": "stages/cypress-e2e.sh",
    "requiresAgentId": true,
    "artifacts": [
      {
        "path": ".har/artifacts/cypress-e2e",
        "kind": "directory",
        "description": "Cypress run log, screenshots, and videos"
      },
      {
        "path": ".har/artifacts/cypress-e2e/cypress.log",
        "kind": "log"
      }
    ],
    "tier": "full"
  },
  "files": [
    {
      "src": ".har/stages/cypress-e2e.sh",
      "dest": ".har/stages/cypress-e2e.sh",
      "executable": true
    },
    {
      "src": ".har/stages/CYPRESS.md",
      "dest": ".har/stages/CYPRESS.md"
    },
    {
      "src": "cypress.config.js",
      "dest": "cypress.config.js"
    },
    {
      "src": "cypress/e2e/smoke.cy.js",
      "dest": "cypress/e2e/smoke.cy.js"
    },
    {
      "src": "cypress/e2e/api.cy.js",
      "dest": "cypress/e2e/api.cy.js"
    },
    {
      "src": "cypress/support/e2e.js",
      "dest": "cypress/support/e2e.js"
    },
    {
      "src": "README.md",
      "dest": "cypress/README.md"
    }
  ],
  "optionalFiles": [
    {
      "src": ".github/workflows/cypress.yml",
      "dest": ".github/workflows/cypress.yml",
      "skipFlag": "skipCi"
    }
  ],
  "merge": {
    "package.json": "package.fragment.json"
  },
  "nextSteps": [
    "npm install",
    "npx cypress verify",
    "har env launch 1",
    "./.har/stages/cypress-e2e.sh 1"
  ],
  "docsPath": ".har/stages/CYPRESS.md"
}
