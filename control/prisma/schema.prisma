generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Repository {
  id              String      @id @default(uuid())
  path            String      @unique
  gitRemote       String?
  manifest        Json?
  stagesRegistry  Json?
  lastSyncAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  slots           AgentSlot[]
  runs            Run[]
  changeBatches   ChangeBatch[]
  sessionUsage    AgentSessionUsage[]
  sessionEvents   AgentSessionEvent[]
  sessionSpans    AgentSessionSpan[]
}

model AgentSlot {
  id               String     @id @default(uuid())
  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  slotId           Int
  active           Boolean    @default(false)
  workDir          String?
  worktreePath     String?
  branch           String?
  previewUrls      Json?
  harnessUsage     String     @default("none")
  lastRunId        String?
  lastRunAt        DateTime?
  lastVerifyStatus String?
  lastBuildPass    Boolean?
  mode             String?
  suffix           String?
  baseBranch       String?
  baseCommit       String?
  sessionCreatedAt DateTime?
  purpose          String?
  detachedHead     Boolean?
  dirty            Boolean?
  ahead            Int?
  behind           Int?
  stale            Boolean?
  updatedAt        DateTime   @updatedAt

  @@unique([repositoryId, slotId])
}

model AgentSessionUsage {
  id                  String     @id @default(uuid())
  repositoryId        String
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sessionKey          String
  agentId             Int
  agentTool           String
  workDir             String?
  branch              String?
  suffix              String?
  tokensInput         BigInt     @default(0)
  tokensOutput        BigInt     @default(0)
  tokensCacheRead     BigInt     @default(0)
  tokensCacheCreation BigInt     @default(0)
  tokensTotal         BigInt     @default(0)
  costUsd             Decimal?
  modelBreakdown      Json?
  sources             Json       @default("[]")
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  updatedAt           DateTime   @updatedAt

  @@unique([repositoryId, sessionKey, agentTool])
  @@index([repositoryId, agentId])
  @@index([lastSeenAt])
}

model AgentSessionEvent {
  id             String     @id @default(uuid())
  repositoryId   String
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sessionKey     String
  agentId        Int
  agentTool      String
  eventName      String
  sequence       Int        @default(0)
  timestamp      DateTime
  attributes     Json?
  promptText     String?
  responseText   String?
  rawTruncated   String?
  source         String     @default("otel")
  createdAt      DateTime   @default(now())

  @@unique([repositoryId, sessionKey, agentTool, eventName, sequence])
  @@index([repositoryId, agentId, timestamp])
  @@index([timestamp])
}

model AgentSessionSpan {
  id             String     @id @default(uuid())
  repositoryId   String
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sessionKey     String
  agentId        Int
  agentTool      String
  traceId        String
  spanId         String
  parentSpanId   String?
  name           String
  startTime      DateTime
  endTime        DateTime?
  attributes     Json?
  createdAt      DateTime   @default(now())

  @@unique([repositoryId, traceId, spanId])
  @@index([repositoryId, agentId, startTime])
}

model Run {
  id           String     @id @default(uuid())
  runId        String
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  stageId      String
  kind         String?
  agentId      Int?
  status       String
  trigger      String
  durationMs   Int?
  startedAt    DateTime
  finishedAt   DateTime?
  workDir      String?
  result       Json?
  createdAt    DateTime   @default(now())

  @@unique([repositoryId, runId])
  @@index([repositoryId, startedAt])
}

model ChangeBatch {
  id           String     @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  validationId String
  treeHash     String
  headSha      String?
  branch       String?
  workDir      String?
  agentId      Int?
  status       String
  full         Boolean    @default(false)
  runId        String?
  changedFiles Json?
  commitSha    String?
  committedAt  DateTime?
  createdAt    DateTime
  updatedAt    DateTime   @updatedAt

  @@unique([repositoryId, treeHash])
  @@index([repositoryId, branch, createdAt])
}

model CloudConfig {
  id        String   @id @default("default")
  apiKey    String?
  apiUrl    String?
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
