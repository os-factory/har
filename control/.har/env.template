# Agent environment — generated by launch.sh from env.template
# DO NOT EDIT — regenerated on every launch
AGENT_ID=${AGENT_ID}
REPO_ROOT=${REPO_ROOT}

# Ports (formula: BASE + AGENT_ID * 10) — Next.js serves UI + API on FE_PORT
PORT=${FE_PORT}
FE_PORT=${FE_PORT}
API_PORT=${FE_PORT}
DEBUG_PORT=${DEBUG_PORT}

# Mission Control Postgres (docker compose up -d db in control/)
DATABASE_URL=postgresql://har:har@localhost:5433/har_control

# Application
NODE_ENV=development
SITE_URL=http://localhost:${FE_PORT}
