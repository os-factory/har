# Agent environment — generated by launch.sh from env.template
# DO NOT EDIT — regenerated on every launch
AGENT_ID=${AGENT_ID}
REPO_ROOT=${REPO_ROOT}

# Ports (formula: BASE + AGENT_ID * 10) — Next.js serves UI + API on FE_PORT
PORT=${FE_PORT}
FE_PORT=${FE_PORT}
API_PORT=${FE_PORT}
DEBUG_PORT=${DEBUG_PORT}

# Per-agent SQLite database — created by `prisma db push` at launch.
# Resolved relative to prisma/schema.prisma → control/prisma/agent_${AGENT_ID}.db
DATABASE_URL=file:./agent_${AGENT_ID}.db

# Application
NODE_ENV=development
SITE_URL=http://localhost:${FE_PORT}

# Public PostHog client token — instrumentation-client.ts requires this even
# outside production, otherwise the app throws on load (breaks browser-e2e).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_Btprma6YFgCEh22DcBWUJTf7YLWMrEymWmCWxeRGUsJG
