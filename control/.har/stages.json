{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 3
  },
  "verificationStages": [
    "typecheck",
    "unit-tests",
    "api-health",
    "lint",
    "readiness",
    "browser-e2e",
    "docker-build"
  ],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch an isolated agent environment slot",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick: typecheck/tests/health; --full adds lint, browser-e2e, docker-build)",
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs such as reports, traces, screenshots, and logs"
        }
      ],
      "acceptsArgs": [
        "--full"
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect a running agent environment slot",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "artifacts": []
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Stop processes and release agent slot resources",
      "artifacts": []
    },
    {
      "id": "browser-e2e",
      "kind": "test",
      "description": "Playwright E2E (frontend + API + a11y)",
      "script": "stages/browser-e2e.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/browser-e2e",
          "kind": "directory",
          "description": "HTML report, traces, screenshots, videos"
        },
        {
          "path": ".har/artifacts/browser-e2e/playwright-report",
          "kind": "report"
        }
      ],
      "requiresAgentId": true
    },
    {
      "id": "docker-build",
      "kind": "test",
      "description": "Build Mission Control Docker image and smoke-boot it (prisma db push + /api/health; no push; native platform)",
      "script": "stages/docker-build.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/docker-build",
          "kind": "directory",
          "description": "Docker build logs and smoke-boot logs"
        }
      ],
      "requiresAgentId": true
    },
    {
      "id": "typecheck",
      "kind": "test",
      "description": "Type check (ecosystem quick smoke)",
      "command": "${NPM_BIN:-npm} run typecheck",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "quick"
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "description": "Unit tests",
      "command": "${NPM_BIN:-npm} test",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "quick"
    },
    {
      "id": "lint",
      "kind": "test",
      "description": "Lint",
      "command": "${NPM_BIN:-npm} run lint",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "readiness",
      "kind": "test",
      "description": "Project readiness smoke (HARNESS_READINESS_CMD)",
      "script": "stages/readiness.sh",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "api-health",
      "kind": "test",
      "tier": "quick",
      "requiresAgentId": true,
      "artifacts": [],
      "script": "stages/api-health.sh",
      "description": "API health check on the slot's dev server"
    }
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  }
}
