{
  "version": "1",
  "agentSlots": {
    "min": 1,
    "max": 3
  },
  "verificationStages": [
    "typecheck",
    "unit-tests",
    "api-health",
    "lint",
    "browser-e2e",
    "docker-build"
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  },
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure",
      "command": "./.har/setup-infra.sh"
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch an isolated agent environment slot",
      "command": "./.har/launch.sh {agentId}",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick: typecheck/tests/health; --full adds lint, browser-e2e, docker-build)",
      "command": "./.har/verify.sh {agentId}",
      "acceptsArgs": ["--full"],
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs such as reports, traces, screenshots, and logs"
        }
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect a running agent environment slot",
      "command": "./.har/agent-cli.sh {agentId} status",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "command": "./.har/agent-cli.sh {agentId} logs"
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Stop processes and release agent slot resources",
      "command": "./.har/teardown.sh {agentId}"
    },
    {
      "id": "browser-e2e",
      "kind": "test",
      "description": "Playwright E2E (frontend + API + a11y)",
      "script": "stages/browser-e2e.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/browser-e2e",
          "kind": "directory",
          "description": "HTML report, traces, screenshots, videos"
        },
        {
          "path": ".har/artifacts/browser-e2e/playwright-report",
          "kind": "report"
        }
      ],
      "requiresAgentId": true
    },
    {
      "id": "docker-build",
      "kind": "test",
      "description": "Build Mission Control Docker image and smoke-boot it (prisma db push + /api/health; no push; native platform)",
      "script": "stages/docker-build.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/docker-build",
          "kind": "directory",
          "description": "Docker build logs and smoke-boot logs"
        }
      ],
      "requiresAgentId": true
    }
  ]
}
