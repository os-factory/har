{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "verificationStages": [
    "typecheck",
    "unit-tests",
    "api-health",
    "lint",
    "browser-e2e"
  ],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Shared infrastructure (Docker, template DB)",
      "command": "./.har/setup-infra.sh",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch an isolated agent environment slot",
      "command": "./.har/launch.sh {agentId}",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (typecheck, unit tests, health; --full adds lint and browser-e2e)",
      "command": "./.har/verify.sh {agentId}",
      "acceptsArgs": ["--full"],
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs such as reports, traces, screenshots, and logs"
        }
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect a running agent environment slot",
      "command": "./.har/agent-cli.sh {agentId} status",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "command": "./.har/agent-cli.sh {agentId} logs",
      "artifacts": []
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Stop processes and release agent slot resources",
      "command": "./.har/teardown.sh {agentId}",
      "artifacts": []
    },
    {
      "id": "browser-e2e",
      "kind": "test",
      "description": "Playwright E2E (frontend + API + a11y)",
      "script": "stages/browser-e2e.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/browser-e2e",
          "kind": "directory",
          "description": "HTML report, traces, screenshots, videos"
        },
        {
          "path": ".har/artifacts/browser-e2e/playwright-report",
          "kind": "report"
        }
      ],
      "requiresAgentId": true
    }
  ]
}
