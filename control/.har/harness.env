# Shared harness configuration — edit to match your project
# Generated by har env init, maintained over time with har env maintain

export HARNESS_PROJECT_NAME=control
export HARNESS_USE_WORKTREE=true

# Primary application — the ONE app agents modify and run per-slot.
# Mission Control is a single Next.js app (UI + API on one port).
export HARNESS_PRIMARY_APP=web

export HARNESS_TEMPLATE_DB=template_control
export HARNESS_FE_BASE_PORT=3837
export HARNESS_API_BASE_PORT=3837
export HARNESS_HEALTH_CHECK_PATH=/api/health

# Agent slot limits — set based on what your machine can run in parallel
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# Shared infrastructure — docker compose services from docker-compose.agent.yml,
# started ONCE by setup-infra.sh and shared by all agent slots. Control needs
# one Postgres; each slot gets its own database cloned from the template DB.
export HARNESS_INFRA_SERVICES="db"

# Returns 0 when a shared infra service is enabled: har_infra_enabled db
har_infra_enabled() {
  case " ${HARNESS_INFRA_SERVICES:-} " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Postgres client — uses host tools when installed, otherwise docker exec into
# the shared db container (har-control-db-1).
har_pg() {
  local tool="$1"; shift
  if command -v "$tool" >/dev/null 2>&1; then
    PGPASSWORD=password "$tool" -h localhost -p "${AGENT_DB_PORT:-15432}" -U postgres "$@"
  else
    docker exec -i -e PGPASSWORD=password "har-${HARNESS_PROJECT_NAME}-db-1" "$tool" -U postgres "$@"
  fi
}

# Database setup commands. setup-infra.sh runs migrate once against the template
# DB (DATABASE_URL unset there → fallback); launch.sh re-runs it per slot with the
# agent's env sourced, so DATABASE_URL points at agent_<id> (idempotent).
export HARNESS_DB_MIGRATE_CMD='DATABASE_URL="${DATABASE_URL:-postgresql://postgres:password@localhost:15432/template_control}" npx prisma db push --skip-generate'
export HARNESS_DB_SEED_CMD="true"
