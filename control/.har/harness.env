# Shared harness configuration — edit to match your project
# Generated by har env init, maintained over time with har env maintain

export HARNESS_PROJECT_NAME=control
export HARNESS_USE_WORKTREE=true

# Primary application — the ONE app agents modify and run per-slot.
# Mission Control is a single Next.js app (UI + API on one port).
export HARNESS_PRIMARY_APP=web

# Mission Control uses an embedded SQLite database — no shared DB server. Each
# agent slot gets its own SQLite file (control/prisma/agent_<id>.db), created by
# `prisma db push` at launch. No template DB to clone.
export HARNESS_TEMPLATE_DB=""

# Per-slot app ports — slot 1 defaults to 3847 (3837 + 1 × 10). Conflicts with
# `har control up` on the same port; run `har control down` before launch 1.
export HARNESS_FE_BASE_PORT=3837
export HARNESS_API_BASE_PORT=3837
export HARNESS_PORT_STEP=10
export HARNESS_HEALTH_CHECK_PATH=/api/health

# Agent slot limits — set based on what your machine can run in parallel
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# Toolchain provisioning — launch writes resolved paths into .env.agent.<id>
export HARNESS_ECOSYSTEM="auto"
# export HARNESS_INSTALL_CMD="npm ci"

# Shared infrastructure — docker compose services from docker-compose.agent.yml,
# started ONCE by setup-infra.sh and shared by all agent slots. Mission Control
# is self-contained (embedded SQLite), so NO shared infra is needed.
export HARNESS_INFRA_SERVICES=""

# Database setup commands. launch runs migrate per slot with the agent's env
# sourced, so DATABASE_URL (from env.template) points at the slot's SQLite file
# (control/prisma/agent_<id>.db, idempotent create). `db push` (without
# --skip-generate) also regenerates the Prisma client, which encodes the
# datasource provider — important after the Postgres→SQLite switch.
export HARNESS_DB_MIGRATE_CMD='npx prisma db push'
export HARNESS_DB_SEED_CMD="true"
