# HAR CLI dogfooding harness — no Docker/PM2 infra required
# Generated by har env init, customized for @har/cli development

export HARNESS_PROJECT_NAME=har_project
export HARNESS_FE_BASE_PORT=3000
export HARNESS_API_BASE_PORT=8000
export HARNESS_HEALTH_CHECK_PATH=

# Agent slot limits — parallel worktrees / verify runs
export HARNESS_AGENT_SLOT_MIN=1
export HARNESS_AGENT_SLOT_MAX=3

# No shared infrastructure for this CLI repo
export HARNESS_INFRA_POSTGRES=false
export HARNESS_INFRA_MINIO=false
export HARNESS_INFRA_BROWSER=false
export HARNESS_INFRA_MAILPIT=false

export HARNESS_DB_MIGRATE_CMD="true"
export HARNESS_DB_SEED_CMD="true"
