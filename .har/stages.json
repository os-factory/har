{
  "version": "1",
  "artifactsDir": "artifacts",
  "logsDir": "logs",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "verificationStages": [
    "typecheck",
    "build",
    "docs-check",
    "docs-build",
    "unit-tests",
    "lint",
    "readiness",
    "docs-drift",
    "fixture-e2e"
  ],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure",
      "artifacts": []
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Prepare agent slot (git worktree, deps, env file)",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick: typecheck/build/docs; --full adds tests, lint, docs-drift)",
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs"
        }
      ],
      "acceptsArgs": [
        "--full"
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect agent slot status and worktree path",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "docs-drift",
      "kind": "custom",
      "description": "Validate documentation against CLI, MCP, stage, profile, template, and skill contracts",
      "command": "(cd docs && ${NPM_BIN:-npm} run drift)",
      "artifacts": [],
      "requiresAgentId": false,
      "group": "documentation"
    },
    {
      "id": "fixture-e2e",
      "kind": "test",
      "description": "v1.0.0 milestone gate: run the built CLI end-to-end against a clone of the car-app example (skipped unless HAR_FIXTURE_E2E=1; HAR_FIXTURE_MILESTONE=M0..M5 adds milestone asserts)",
      "script": "stages/fixture-e2e.sh",
      "artifacts": [
        {
          "path": ".har/artifacts/fixture-e2e",
          "kind": "directory",
          "description": "Gate logs and fixture status snapshots"
        }
      ],
      "requiresAgentId": true,
      "group": "release-gate"
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Remove worktree and env file for the slot",
      "artifacts": []
    },
    {
      "id": "typecheck",
      "kind": "test",
      "description": "Type check (ecosystem quick smoke)",
      "command": "${NPM_BIN:-npm} run typecheck",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "quick"
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "description": "Unit tests",
      "command": "${NPM_BIN:-npm} test",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "lint",
      "kind": "test",
      "description": "Lint",
      "command": "${NPM_BIN:-npm} run lint",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "readiness",
      "kind": "test",
      "description": "Project readiness smoke (HARNESS_READINESS_CMD)",
      "script": "stages/readiness.sh",
      "artifacts": [],
      "requiresAgentId": true,
      "tier": "full"
    },
    {
      "id": "build",
      "kind": "test",
      "tier": "quick",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "${NPM_BIN:-npm} run build",
      "description": "Build the CLI bundle"
    },
    {
      "id": "docs-check",
      "kind": "test",
      "tier": "quick",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "(cd docs && ${NPM_BIN:-npm} run check)",
      "description": "Astro docs typecheck (astro check)"
    },
    {
      "id": "docs-build",
      "kind": "test",
      "tier": "quick",
      "requiresAgentId": true,
      "artifacts": [],
      "command": "(cd docs && ${NPM_BIN:-npm} run build)",
      "description": "Astro docs build"
    }
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  }
}
