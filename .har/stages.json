{
  "version": "1",
  "agentSlots": {
    "min": 1,
    "max": 3
  },
  "verificationStages": ["docs-drift"],
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure",
      "command": "./.har/setup-infra.sh"
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Prepare agent slot (git worktree, deps, env file)",
      "command": "./.har/launch.sh {agentId}",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick by default; --full adds lint, browser-e2e when installed)",
      "command": "./.har/verify.sh {agentId}",
      "acceptsArgs": ["--full"],
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs"
        }
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect agent slot status and worktree path",
      "command": "./.har/agent-cli.sh {agentId} status",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read recent logs for an agent slot",
      "command": "./.har/agent-cli.sh {agentId} logs"
    },
    {
      "id": "docs-drift",
      "kind": "custom",
      "description": "Validate documentation against CLI, MCP, stage, profile, template, and skill contracts",
      "command": "npm run drift --prefix docs",
      "requiresAgentId": false,
      "group": "documentation"
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Remove worktree and env file for the slot",
      "command": "./.har/teardown.sh {agentId}"
    }
  ]
}
