{
  "version": "1",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "verificationStages": [
    "docs-drift",
    "fixture-e2e"
  ],
  "commitGate": {
    "enabled": true,
    "mode": "block",
    "scope": "worktrees"
  },
  "stages": [
    {
      "id": "setup-infra",
      "kind": "setup",
      "description": "Optional shared Docker infrastructure",
      "command": "./.har/setup-infra.sh"
    },
    {
      "id": "launch",
      "kind": "launch",
      "description": "Prepare agent slot (git worktree, deps, env file)",
      "command": "./.har/launch.sh {agentId}",
      "artifacts": [
        {
          "path": ".env.agent.{agentId}",
          "kind": "file",
          "description": "Generated per-agent environment file in the session work dir"
        }
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Verification pipeline (quick: typecheck/build/docs; --full adds tests, lint, docs-drift)",
      "command": "./.har/verify.sh {agentId}",
      "acceptsArgs": ["--full"],
      "artifacts": [
        {
          "path": ".har/artifacts",
          "kind": "directory",
          "description": "Optional verification outputs"
        }
      ]
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect agent slot status and worktree path",
      "command": "./.har/agent-cli.sh {agentId} status",
      "artifacts": [
        {
          "path": ".har/logs",
          "kind": "directory",
          "description": "Optional harness logs"
        }
      ]
    },
    {
      "id": "docs-drift",
      "kind": "custom",
      "description": "Validate documentation against CLI, MCP, stage, profile, template, and skill contracts",
      "command": "(cd docs && ${NPM_BIN:-npm} run drift)",
      "requiresAgentId": false,
      "group": "documentation"
    },
    {
      "id": "fixture-e2e",
      "kind": "test",
      "description": "v1.0.0 milestone gate: run the built CLI end-to-end against a clone of the car-app example (skipped unless HAR_FIXTURE_E2E=1; HAR_FIXTURE_MILESTONE=M0..M5 adds milestone asserts)",
      "script": "stages/fixture-e2e.sh",
      "requiresAgentId": true,
      "group": "release-gate",
      "artifacts": [
        {
          "path": ".har/artifacts/fixture-e2e",
          "kind": "directory",
          "description": "Gate logs and fixture status snapshots"
        }
      ]
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Remove worktree and env file for the slot",
      "command": "./.har/teardown.sh {agentId}"
    }
  ]
}
