{
  "version": "1",
  "agentSlots": {
    "min": 1,
    "max": 5
  },
  "verificationStages": [
    "smoke"
  ],
  "stages": [
    {
      "id": "launch",
      "kind": "launch",
      "description": "Launch agent slot",
      "requiresAgentId": true
    },
    {
      "id": "verify",
      "kind": "verify",
      "description": "Run verification",
      "requiresAgentId": true
    },
    {
      "id": "teardown",
      "kind": "teardown",
      "description": "Tear down agent slot",
      "requiresAgentId": true
    },
    {
      "id": "status",
      "kind": "inspect",
      "description": "Inspect agent slot"
    },
    {
      "id": "logs",
      "kind": "inspect",
      "description": "Read agent logs"
    },
    {
      "id": "smoke",
      "kind": "custom",
      "description": "Smoke test stage",
      "script": "stages/smoke.sh",
      "requiresAgentId": true
    }
  ]
}
