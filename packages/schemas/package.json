{
  "name": "@har/schemas",
  "version": "2.0.0-next.7",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ingest-v2-contract-cli": "./dist/ingest-v2-contract-cli.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "ingest-v2-contract": "dist/ingest-v2-contract-cli.js"
  },
  "files": [
    "src",
    "pricing-vectors.json",
    "dist",
    "tsconfig.build.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pricing-vectors": "node dist/pricing-vectors-cli.js --out pricing-vectors.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@pydantic/genai-prices": "^0.2.3",
    "zod": "^4.6.7"
  }
}
